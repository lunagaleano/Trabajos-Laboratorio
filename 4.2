'''Escribe un programa que lea un arreglo de números enteros y luego muestre el elemento máximo del arreglo.'''

numeros = []

n = int(input("¿Cuantos numeros desea ingresar?: "))

for i in range(n):
    num = int(input("Ingrese un numero: "))
    numeros.append(num)

maximo = numeros[0]

for num in numeros:
    if num > maximo:
        maximo = num

print("El numero maximo es:", maximo)