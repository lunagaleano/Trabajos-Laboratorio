'''Escribe un programa que pida al usuario que ingrese un número y
luego muestre la suma de los números impares desde 1 hasta ese número'''

numero = int(input("Ingrese un numero: "))
suma = 0

for i in range(1, numero + 1):
    if i % 2 != 0:
        suma = suma + i

print("La suma de los numeros impares es:", suma)